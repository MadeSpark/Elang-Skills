# 以 . 开头的 IDE / 工具目录，不入库
/.codebuddy/
/.workbuddy/
/.tmp/
/.vscode/
/.idea/
/.git/

# ---------------------------------------------------------------------------
# 发布区 Releases/ **不入库**：成品只通过 GitHub Release 附件分发（Elang-AiTools.zip），
# 仓库不再携带这份成品副本（避免上游把成品与逆向中间物混在一起推送）。
# 源本仍在工作区（tools/ docs/ src/ 与 Releases/ 本地目录都在），发布时现打压缩包上传为
# Release 资产即可；skills/*/scripts|references|assets 与 tools/ docs/ src/ 的逐字节一致
# 仍可用 tools/verify-release.py 在本地核验。
# ---------------------------------------------------------------------------
/Releases/

# Python 运行产物
__pycache__/

# dist/ 里的技能分发包：内容可从 Releases/ 完全再生，**不入库**。
# 它还有一个硬理由：打包字节**跨环境不可复现** —— 同样的源内容，zlib 与 zlib-ng
# 压出的 deflate 流不同（CRC 相同、compress_size 不同），入库只会每次打包都产生
# 无意义的二进制 diff。要发给别人时跑 python tools/pack-skill.py 现打即可。
/dist/

# 上游技能克隆与第三方下载（体积大，不入库；来源见 docs/ 各参考文档脚注）
/re/_upstream_e-language-skill/
/re/_upstream_dl/
/re/up_test/
/re/epk_test/
/re/compile_test/

# ---------------------------------------------------------------------------
# 本机测试用的依赖副本 —— **必须忽略**，否则 git add -A 会把 33.6 MB 的
# node.dll 塞进仓库（miniblink 内核 x86，33,600,512 B）。
# 真实依赖在用户项目里（<工程>\main\corn\），这里是复制进来给 MbKit 跑测试的。
# ---------------------------------------------------------------------------
/main/

# ---------------------------------------------------------------------------
# 逆向/试验产生的大体量中间物，不入库。
# ⚠️ 注意：.gitignore **不支持行尾注释** —— 模式后面的 `# ……` 会被当成模式
#    的一部分，规则静默失效（这个坑刚踩过）。注释必须单独占一行。
#
#   /re/epk_q/           2MB 真实工程往返矩阵的工作区，约 311 MB
#   /re/gui_probe/       form.json 字段测绘的中间产物
#   /re/headless_verify/ 无头验证的中间取样
#   /re/cmt_test/        注释语法实验的中间产物
#
# 保留：re/mb/（miniblink 文本与研究脚本）、re/mbkit_run/evidence/（小型证据日志）
# ---------------------------------------------------------------------------
/re/epk_q/
/re/gui_probe/
/re/headless_verify/
/re/cmt_test/

# 工具运行留下的游离日志（e2txt 的 trace）
/e2txt_trace.log

# ---------------------------------------------------------------------------
# 用户真实工程（AILI·LIFE）的测试副本：含 16 MB 的 .e 与 14 MB 的资源，
# 属用户业务代码，**绝不入库**。
# ---------------------------------------------------------------------------
/re/aili/

# ---------------------------------------------------------------------------
# re/opt/ 是「无头编译 / 自定义 node 路径」的研究目录：顶层是脚本，下面每个
# 子目录都是**一次实验的临时工程**（其中 e2e*/ 里还各躺着一份 33.6 MB 的
# node.dll 内核副本，合计 ~130 MB）。
# ⇒ 规则：子目录**一律忽略**，只放行 evidence/（小型证据日志）；顶层 *.py 不受影响。
#    这样将来新增实验目录**自动**被挡住，不会因为忘了加规则而把上百 MB 卷进仓库。
# ---------------------------------------------------------------------------
/re/opt/*/
!/re/opt/evidence/

# ---------------------------------------------------------------------------
# re/pe_loader/ —— 「手写机器码内存加载 PE」的实验目录（2026-09-24）。
# 结论见 docs/分析-内存加载PE与内核共用（2026-09-24）.md。
#
# 入库：顶层 *.py 实验脚本、exp/*.c 与 lock/*.c 源码、用户样本（PE加载器.e / test.*）、
#       txt/（样本的 e2t 文本 —— 机器码字节的唯一引用源）与全部小型证据日志。
# 忽略：内核副本（33.6 MB）、一切编译产物、以及可由脚本再生的中间工程。
#       proj/ 由 build_probe.py 生成；work/ 是逐次探针工程的落盘；三者都能重跑出来。
# ---------------------------------------------------------------------------
/re/pe_loader/share/kernel/
/re/pe_loader/work/
/re/pe_loader/proj/
/re/pe_loader/exp/*.dll
/re/pe_loader/exp/*.a
/re/pe_loader/lock/holder.exe
/re/pe_loader/out/probe_pe.exe
/re/pe_loader/out/expdll.dll
/re/pe_loader/share/*/probe.exe
/re/pe_loader/share/*/MbKit.dll


# ---------------------------------------------------------------------------
# QAQ-ETool 的 .NET 构建产物与 ZCode 工具目录，不入库（可由构建再生）。
# ---------------------------------------------------------------------------
QAQ-ETool/src/**/bin/
QAQ-ETool/src/**/obj/
/.zcode/

# ---------------------------------------------------------------------------
# work_host 是未开源的私有宿主代码，永远不入库。
# ---------------------------------------------------------------------------
/work_host/

# ---------------------------------------------------------------------------
# 本机临时/备份目录（2026-10-29 清理后归入忽略，避免长期挂在 git status 里）
#   .local/            gh CLI 的本机状态
#   _analysis/         逆向取证中间物（仅保留 forensics-report.md 结论稿）
#   gh_v314_probe/     XiaoLiZiVM SDK 3.1.4/3.1.5 的对比笔记
#   backup_*/          本机工程备份（含用户真实工程副本，绝不入库）
# ---------------------------------------------------------------------------
/.local/
/_analysis/
/gh_v314_probe/
/backup_*/
