# 以 . 开头的 IDE / 工具目录，不入库
/.codebuddy/
/.workbuddy/
/.tmp/
/.vscode/
/.idea/
/.git/

# 发布区成品**必须入库**：四个 SKILL.md、使用说明、三个安装入口都只在这里手工维护，
# 工程侧没有它们的源本 —— 不入库就是单点存储，丢了无法重建。
# （skills/*/scripts|references|assets 是 tools/ docs/ src/ 的同步副本，
#   verify-release.py 会断言它们与源本逐字节一致，所以入库还能顺带暴露「改完忘同步」。）
# 曾经的坑：整目录忽略时，dist/ 里的分发包会与发布区内容悄悄漂移，而 git 完全看不见。
#
# 只忽略**发布附件本身**（打包好的压缩包）—— 这正是 bafd77e 那次提交的原本意图，
# 当时把规则写成 `/Releases/`，连整个目录一起忽略了，属于误伤。
/Releases/**/*.zip
/Releases/**/*.tar.gz

# Python 运行产物
__pycache__/

# dist/ 里的技能分发包：内容可从 Releases/ 完全再生，**不入库**。
# 它还有一个硬理由：打包字节**跨环境不可复现** —— 同样的源内容，zlib 与 zlib-ng
# 压出的 deflate 流不同（CRC 相同、compress_size 不同），入库只会每次打包都产生
# 无意义的二进制 diff。要发给别人时跑 python tools/pack-skill.py 现打即可。
/dist/

# 上游技能克隆与第三方下载（体积大，不入库；来源见 docs/ 各参考文档脚注）
/re/_upstream_e-language-skill/
/re/_upstream_dl/
/re/up_test/
/re/epk_test/
/re/compile_test/

# ---------------------------------------------------------------------------
# 本机测试用的依赖副本 —— **必须忽略**，否则 git add -A 会把 33.6 MB 的
# node.dll 塞进仓库（miniblink 内核 x86，33,600,512 B）。
# 真实依赖在用户项目里（<工程>\main\corn\），这里是复制进来给 MbKit 跑测试的。
# ---------------------------------------------------------------------------
/main/

# ---------------------------------------------------------------------------
# 逆向/试验产生的大体量中间物，不入库。
# ⚠️ 注意：.gitignore **不支持行尾注释** —— 模式后面的 `# ……` 会被当成模式
#    的一部分，规则静默失效（这个坑刚踩过）。注释必须单独占一行。
#
#   /re/epk_q/           2MB 真实工程往返矩阵的工作区，约 311 MB
#   /re/gui_probe/       form.json 字段测绘的中间产物
#   /re/headless_verify/ 无头验证的中间取样
#   /re/cmt_test/        注释语法实验的中间产物
#
# 保留：re/mb/（miniblink 文本与研究脚本）、re/mbkit_run/evidence/（小型证据日志）
# ---------------------------------------------------------------------------
/re/epk_q/
/re/gui_probe/
/re/headless_verify/
/re/cmt_test/

# 工具运行留下的游离日志（e2txt 的 trace）
/e2txt_trace.log

# ---------------------------------------------------------------------------
# 用户真实工程（AILI·LIFE）的测试副本：含 16 MB 的 .e 与 14 MB 的资源，
# 属用户业务代码，**绝不入库**。
# ---------------------------------------------------------------------------
/re/aili/

# ---------------------------------------------------------------------------
# re/opt/ 是「无头编译 / 自定义 node 路径」的研究目录：顶层是脚本，下面每个
# 子目录都是**一次实验的临时工程**（其中 e2e*/ 里还各躺着一份 33.6 MB 的
# node.dll 内核副本，合计 ~130 MB）。
# ⇒ 规则：子目录**一律忽略**，只放行 evidence/（小型证据日志）；顶层 *.py 不受影响。
#    这样将来新增实验目录**自动**被挡住，不会因为忘了加规则而把上百 MB 卷进仓库。
# ---------------------------------------------------------------------------
/re/opt/*/
!/re/opt/evidence/

